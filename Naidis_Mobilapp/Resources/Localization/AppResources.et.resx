  <data name="CityPlaceKadriorgDetail" xml:space="preserve"><value>Kadrioru park on rahulik roheala, kus asuvad Kadrioru loss, kunstimuuseumid, jalutusrajad, lilleaiad ja vaiksed puhkekohad.</value></data>
  <data name="CityPlacePiritaName" xml:space="preserve"><value>Pirita rand</value></data>
  <data name="CityPlacePiritaShort" xml:space="preserve"><value>Mereäärne paik jalutamiseks, ujumiseks ja päikeseloojanguteks.</value></data>
