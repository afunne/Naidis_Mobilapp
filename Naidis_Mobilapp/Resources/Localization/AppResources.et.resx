  <data name="CityPlaceOldTownDetail" xml:space="preserve"><value>Tallinna vanalinn on üks paremini säilinud keskaegseid linnakeskusi Euroopas, kus on munakivitänavad, linnamüür, tornid, kohvikud ja vaateplatvormid.</value></data>
  <data name="CityPlaceToompeaName" xml:space="preserve"><value>Toompea loss</value></data>
