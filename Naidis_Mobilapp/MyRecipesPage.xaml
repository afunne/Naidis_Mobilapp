<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Naidis_Mobilapp.MyRecipesPage"
             Title="Minu retseptid"
             BackgroundColor="#F7F2EA">
    <Grid RowDefinitions="Auto, *"
          Padding="14"
          RowSpacing="12">
        <Label Text="Minu retseptid"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#26382B" />

        <ListView x:Name="RecipesList"
                  Grid.Row="1"
                  IsGroupingEnabled="True"
                  HasUnevenRows="True"
                  ItemTapped="OnRecipeTapped"
                  SeparatorVisibility="Default"
                  SeparatorColor="#DED4C3"
                  BackgroundColor="#F7F2EA">
            <ListView.GroupHeaderTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="12,8"
                              BackgroundColor="#355E3B">
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.GroupHeaderTemplate>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.ContextActions>
                            <MenuItem Text="Kustuta"
                                      IsDestructive="True"
                                      Clicked="OnDeleteClicked"
                                      CommandParameter="{Binding .}" />
                        </ViewCell.ContextActions>

                        <Grid ColumnDefinitions="80, *"
                              Padding="10"
                              ColumnSpacing="12"
                              BackgroundColor="White">
                            <Image Source="{Binding ImageLink}"
                                   WidthRequest="70"
                                   HeightRequest="70"
                                   Aspect="AspectFill"
                                   Grid.Column="0"
                                   BackgroundColor="#E9DED0" />

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="5">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#26382B"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="#6B716C"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding RatingText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2E8B57" />
                            </VerticalStackLayout>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>
